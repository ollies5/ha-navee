      "not_in_range": "The scooter is not in Bluetooth range of a connectable adapter or proxy.",
      "auth_rejected": "The scooter rejected this owner identity.",
      "wrong_scooter": "Connected, but this is not the configured scooter.",
      "cannot_connect": "Could not connect. Close the NAVEE app and Volt, wake the scooter and try again."
    },
    "abort": {
      "already_configured": "This scooter is already configured.",
