          "address": "Scooter"
        }
      },
      "identity": {
        "title": "Owner identity for {name}",
        "description": "Paste the owner identity: 12 hex characters, a Volt setup file, or a captured log line containing `Send authData: 55aa0030…`. See the README for how to capture it once from the NAVEE app. Close the NAVEE app (and Volt) first: the scooter accepts only one Bluetooth connection.",
        "data": {
          "identity": "Owner identity",
          "shared_user": "Shared user (not the owner)"
        },
        "data_description": {
          "identity": "Keep this private: it can unlock and control your scooter."
        }
      },
      "reauth_confirm": {
        "title": "Owner identity rejected",
        "description": "The scooter rejected the saved identity (for example after re-binding it to another account). Paste the owner identity: 12 hex characters, a Volt setup file, or a captured log line containing `Send authData: 55aa0030…`. See the README for how to capture it once from the NAVEE app. Close the NAVEE app (and Volt) first: the scooter accepts only one Bluetooth connection.",
        "data": {
          "identity": "Owner identity",
          "shared_user": "Shared user (not the owner)"
        }
      }
    },
    "error": {
      "invalid_identity": "No owner identity found. Enter 12 hex characters, a setup file or a captured authData line.",
